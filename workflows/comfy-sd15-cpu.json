{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "v1-5-pruned-emaonly-fp16.safetensors" },
    "_meta": { "title": "SD1.5 FP16 / Comfy-Org" }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "{{prompt}}", "clip": ["1", 1] },
    "_meta": { "title": "画像のプロンプト（英語推奨）" }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "blurry, low quality, watermark, text", "clip": ["1", 1] }
  },
  "4": {
    "class_type": "EmptyLatentImage",
    "inputs": { "width": 384, "height": 384, "batch_size": 1 }
  },
  "5": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["1", 0], "positive": ["2", 0], "negative": ["3", 0], "latent_image": ["4", 0],
      "seed": "{{seed}}", "steps": 8, "cfg": 6, "sampler_name": "euler", "scheduler": "normal", "denoise": 1
    },
    "_meta": { "title": "CPU向けプレビュー / 384px・8ステップ" }
  },
  "6": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["5", 0], "vae": ["1", 2] }
  },
  "7": {
    "class_type": "SaveImage",
    "inputs": { "images": ["6", 0], "filename_prefix": "Cutton_SD15" }
  }
}
